    :root {
      --primary: #0284c7;
      --primary-dark: #0369a1;
      --primary-light: #e0f2fe;
      --accent: #f59e0b;
      --bg: #f8fafc;
      --sidebar-bg: #ffffff;
      --panel-bg: #ffffff;
      --border: #e2e8f0;
      --border-focus: #38bdf8;
      --text-main: #0f172a;
      --text-muted: #334155;
      --text-sub: #64748b;
      --bull: #10b981;
      --bull-bg: #ecfdf5;
      --bull-border: #a7f3d0;
      --bear: #ef4444;
      --bear-bg: #fef2f2;
      --bear-border: #fecaca;
      --trap: #f59e0b;
      --trap-bg: #fffbeb;
      --trap-border: #fde68a;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      background: var(--bg);
      color: var(--text-main);
      line-height: 1.68;
      display: flex;
      height: 100vh;
      overflow: hidden;
    }

    /* Left Sidebar */
    .sidebar {
      width: 360px;
      min-width: 360px;
      height: 100vh;
      background: var(--sidebar-bg);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.02);
      z-index: 20;
    }

    .sidebar-header {
      padding: 24px 20px 16px;
      border-bottom: 1px solid var(--border);
      background: #ffffff;
    }

    .brand-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: #0f172a;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .brand-title i {
      color: var(--primary);
    }

    .brand-subtitle {
      font-size: 0.80rem;
      color: var(--text-sub);
      font-weight: 500;
      margin-top: 4px;
      margin-bottom: 14px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .search-box {
      position: relative;
    }
    .search-box input {
      width: 100%;
      padding: 9px 12px 9px 34px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: #f1f5f9;
      color: var(--text-main);
      font-size: 0.85rem;
      outline: none;
      transition: all 0.2s ease;
    }
    .search-box input:focus {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }
    .search-icon {
      position: absolute;
      left: 11px;
      top: 11px;
      font-size: 0.85rem;
      color: var(--text-sub);
    }

    .sidebar-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 16px 14px 40px;
    }

    .nav-group {
      margin-bottom: 20px;
    }

    .nav-group-title {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--primary-dark);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 6px 10px;
      border-radius: 6px;
      background: #f8fafc;
      margin-bottom: 6px;
    }
    .nav-group-title a {
      color: inherit;
      text-decoration: none;
    }

    .nav-list {
      list-style: none;
    }

    .nav-item {
      margin-bottom: 2px;
    }

    .nav-link {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 10px;
      border-radius: 6px;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.88rem;
      line-height: 1.35;
      transition: all 0.15s ease;
    }
    .nav-link:hover {
      background: #f0f9ff;
      color: var(--primary-dark);
    }
    .nav-link.active {
      background: #e0f2fe;
      color: #0369a1;
      font-weight: 600;
    }

    .nav-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: auto;
      min-width: 20px;
      padding: 0 5px;
      height: 20px;
      background: #e2e8f0;
      color: #475569;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .nav-link.active .nav-num {
      background: #0284c7;
      color: #ffffff;
    }

    .nav-link.nav-sub {
      padding-left: 30px;
      font-size: 0.84rem;
    }

    /* Main View */
    .main-view {
      flex: 1;
      height: 100vh;
      overflow-y: auto;
      background: var(--bg);
      display: flex;
      flex-direction: column;
    }

    /* Top Sticky Bar */
    .topbar {
      position: sticky;
      top: 0;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      padding: 12px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 10;
    }
    .topbar-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .badge-primary {
      background: #e0f2fe;
      color: #0369a1;
      border: 1px solid #bae6fd;
    }
    .badge-success {
      background: #ecfdf5;
      color: #047857;
      border: 1px solid #a7f3d0;
    }

    .topbar-links {
      display: flex;
      gap: 8px;
    }
    .topbar-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 6px;
      background: #ffffff;
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.82rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .topbar-btn:hover {
      background: #f1f5f9;
      color: var(--primary);
      border-color: #cbd5e1;
    }

    /* Reading Container - Ultra-wide 96% viewport span */
    .content-area {
      max-width: 96%;
      width: 96%;
      margin: 0 auto;
      padding: 30px 24px 80px;
    }

    /* Hero Banner */
    .hero-header {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      border-radius: 16px;
      padding: 36px 40px;
      margin-bottom: 40px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      position: relative;
      overflow: hidden;
    }
    .hero-header::after {
      content: "";
      position: absolute;
      top: 0; right: 0;
      width: 320px; height: 100%;
      background: radial-gradient(circle, rgba(2, 132, 199, 0.25) 0%, rgba(2, 132, 199, 0) 70%);
      pointer-events: none;
    }
    .hero-header h1 {
      font-size: 2.1rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
      color: #ffffff;
    }
    .hero-header p {
      font-size: 1.02rem;
      color: #94a3b8;
      max-width: 900px;
      line-height: 1.6;
    }

    /* Part Heading Banner */
    .part-heading {
      font-size: 1.55rem;
      font-weight: 800;
      color: #0f172a;
      margin-top: 54px;
      margin-bottom: 24px;
      padding: 14px 20px;
      background: #ffffff;
      border-left: 6px solid var(--primary);
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Chapter Cards */
    .rule-card {
      background: var(--panel-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 32px 36px;
      margin-bottom: 30px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
      transition: box-shadow 0.2s ease;
    }
    .rule-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
    }

    .chapter-heading {
      font-size: 1.30rem;
      font-weight: 700;
      color: #0369a1;
      padding-bottom: 12px;
      border-bottom: 2px solid #f1f5f9;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Rule Sub-Headings (H4) */
    .rule-heading {
      font-size: 1.08rem;
      font-weight: 700;
      margin-top: 26px;
      margin-bottom: 12px;
      padding: 8px 14px;
      border-radius: 6px;
      background: #f8fafc;
      border-left: 4px solid #94a3b8;
      color: #1e293b;
    }
    .rule-bull {
      background: var(--bull-bg);
      border-left-color: var(--bull);
      color: #065f46;
    }
    .rule-bear {
      background: var(--bear-bg);
      border-left-color: var(--bear);
      color: #991b1b;
    }
    .rule-trap {
      background: var(--trap-bg);
      border-left-color: var(--trap);
      color: #92400e;
    }
    .rule-calc {
      background: #f0f9ff;
      border-left-color: #0284c7;
      color: #075985;
    }

    /* Sub-rule Section (H5) */
    .subrule-heading {
      font-size: 0.98rem;
      font-weight: 700;
      color: #334155;
      margin-top: 20px;
      margin-bottom: 10px;
      padding: 4px 8px;
      background: #f1f5f9;
      border-radius: 4px;
      display: inline-block;
    }

    /* Deep Nested Lists & Indentations */
    p {
      margin-bottom: 12px;
      color: #334155;
    }
    
    /* Level 1 List */
    ul, ol {
      margin-top: 8px;
      margin-bottom: 18px;
      padding-left: 28px;
    }
    li {
      margin-bottom: 8px;
      color: #1e293b;
      line-height: 1.65;
    }
    
    /* Level 2 Nested List: Clean indentation without vertical border lines */
    li > ul, li > ol {
      margin-top: 6px;
      margin-bottom: 8px;
      padding-left: 22px;
      border-left: none;
      background: transparent;
    }
    li > ul > li {
      font-size: 0.94rem;
      color: #334155;
      margin-bottom: 6px;
    }
    
    /* Level 3 Nested List */
    li > ul > li > ul {
      margin-top: 4px;
      margin-bottom: 6px;
      padding-left: 20px;
      border-left: none;
      background: transparent;
    }
    li > ul > li > ul > li {
      font-size: 0.90rem;
      color: #475569;
    }

    strong {
      color: #0f172a;
      font-weight: 700;
    }

    /* Formulas and Code */
    code {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: #f8fafc;
      color: #0f172a;
      padding: 2px 6px;
      border-radius: 4px;
      border: 1px solid #e2e8f0;
    }
    .code-formula {
      background: #ecfdf5 !important;
      color: #065f46 !important;
      border: 1px solid #a7f3d0 !important;
      font-weight: 600;
      padding: 2px 8px !important;
      border-radius: 6px !important;
    }

    pre {
      background: #f8fafc;
      color: #0f172a;
      border: 1px solid #e2e8f0;
      padding: 16px 20px;
      border-radius: 10px;
      overflow-x: auto;
      margin: 16px 0;
      font-family: var(--font-mono);
      font-size: 0.88rem;
    }

    /* Tables - Enhanced Crisp Borders & High Legibility */
    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 24px 0;
      font-size: 0.90rem;
      border: 1.5px solid #94a3b8;
      border-radius: 8px;
      overflow: hidden;
      background: #ffffff;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }
    th, td {
      padding: 13px 16px;
      text-align: left;
      border-bottom: 1px solid #cbd5e1;
      border-right: 1px solid #cbd5e1;
      line-height: 1.6;
    }
    th:last-child, td:last-child {
      border-right: none;
    }
    tr:last-child td {
      border-bottom: none;
    }
    th {
      background: #e2e8f0;
      color: #0f172a;
      font-weight: 700;
      font-size: 0.92rem;
      border-bottom: 2px solid #94a3b8;
      letter-spacing: 0.01em;
    }
    tr:nth-child(even) {
      background: #f8fafc;
    }
    tr:hover {
      background: #f0f9ff;
    }

    hr {
      border: none;
      height: 1px;
      background: var(--border);
      margin: 30px 0;
    }

    /* Clickable Headings & Anchor Link Styles */
    h1, h2, h3, h4, h5, h6 {
      cursor: pointer;
      position: relative;
      transition: color 0.15s ease;
    }
    h1:hover, h2:hover, h3:hover, h4:hover, h5:hover, h6:hover {
      color: #0284c7;
    }
    .heading-anchor-icon {
      opacity: 0;
      margin-left: 8px;
      font-size: 0.78em;
      color: #0284c7;
      transition: opacity 0.18s ease;
      vertical-align: middle;
      font-weight: normal;
    }
    h1:hover .heading-anchor-icon,
    h2:hover .heading-anchor-icon,
    h3:hover .heading-anchor-icon,
    h4:hover .heading-anchor-icon,
    h5:hover .heading-anchor-icon,
    h6:hover .heading-anchor-icon {
      opacity: 0.85;
    }

    /* Light Theme Copy Toast */
    .copy-toast {
      position: fixed;
      bottom: 28px;
      right: 28px;
      background: #ffffff;
      color: #0f172a;
      border: 1.5px solid #0284c7;
      box-shadow: 0 10px 30px rgba(2, 132, 199, 0.18), 0 4px 10px rgba(0, 0, 0, 0.06);
      padding: 12px 20px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 10px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(16px);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      z-index: 999999;
      max-width: 520px;
      word-break: break-all;
    }
    .copy-toast.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    @media (max-width: 1024px) {
      .sidebar {
        display: none;
      }
      .content-area {
        padding: 24px;
      }
    }
  </style>
</head>
